{
  "name": "@chorus/voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/sanitize-standalone.mjs",
    "start": "node scripts/start.mjs",
    "worker": "tsx --env-file=.env worker/index.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "tsx --env-file=.env node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "setup": "tsx scripts/setup.ts",
    "bolna:tools": "tsx scripts/generate-tools.ts",
    "bolna:tools:private": "tsx --env-file=.env scripts/generate-tools.ts --private",
    "bolna:sync": "tsx --env-file=.env scripts/sync-bolna-agents.ts",
    "callbacks": "tsx --env-file=.env scripts/callback-gateway.ts",
    "doctor": "tsx --env-file=.env scripts/doctor.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@bolna/web-call": "3.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@xyflow/react": "12.12.0",
    "dotenv": "18.0.8",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.6.0-beta.15",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
