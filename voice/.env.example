DATABASE_URL=postgres://chorus:chorus_local_only@127.0.0.1:55432/chorus
APP_ORIGIN=http://localhost:3000
# Generate with npm run setup. Use 32+ random bytes in production.
SESSION_SECRET=replace-with-at-least-32-random-bytes
# local is allowed only with SIMULATION_ONLY=true and loopback requests.
AUTH_MODE=local
SIMULATION_ONLY=true
DEMO_PASSWORD=replace-with-a-local-login-password
SUPABASE_URL=
# Current low-privilege API key from the project's Connect dialog. No service_role/secret key needed.
SUPABASE_PUBLISHABLE_KEY=
# Compatibility only for existing projects using a legacy anon key.
SUPABASE_ANON_KEY=
BOLNA_API_BASE=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_CONDUCTOR_AGENT_ID=
BOLNA_PHONE_AGENT_ID=
BOLNA_WEBHOOK_SECRET=
BOLNA_TOOL_SECRET=
# Public HTTPS origin for provider callbacks; may differ from the local APP_ORIGIN.
CHORUS_CALLBACK_ORIGIN=
CHORUS_CALLBACK_PORT=3001
ENABLE_REAL_CALLS=false
# Set true only after checking the phone agent duration cap, disabled provider retries, and worst-case call price.
LIVE_AGENT_LIMITS_VERIFIED=false
# Comma-separated E.164 numbers of explicitly authorized participants.
CALL_ALLOWLIST=
# Actual provider plan concurrency, including the browser conductor. Maximum outbound is 3.
ACCOUNT_CONCURRENCY=1
OUTBOUND_CONCURRENCY=3
MAX_CALLS_PER_MISSION=6
MAX_CALL_SECONDS=180
# Reserve the conservative worst-case cost before each dial; paise, independent of mission spending.
CALL_COST_RESERVE_MINOR=5000
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=20:00
CALLING_TIMEZONE=Asia/Kolkata
