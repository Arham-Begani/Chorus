# dependencies and build output
node_modules/
dist/
.vite/
*.tsbuildinfo

# local caches and tooling fetched at setup time
.npm-cache/
.tools/
*.log
*.standalone-bak

# CLI runtime state
cli/logs/
**/chorus-private-state*/
**/*-signing-keys/

# video capture artifacts — regenerated by the recording pipeline
video/capture/
video/frames/
video/out/

# the deployment record is generated by `npm run deploy:<network>`, but it is
# checked in on purpose: it is how a judge finds the deployed contract without
# running anything. Only the UI's runtime copy is ignored.
ui/public/deployment.json

# secrets — the wallet seed must never be committed
.env
.env.local
